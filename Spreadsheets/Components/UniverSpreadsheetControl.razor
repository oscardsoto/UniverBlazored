<style>
    .uov-container {
        position: relative;
        width: 100%;
        min-height: 600px;
    }
    #@Id{
        height: 600px;
        margin: 15px 10px;
    }
    .uov-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.75);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        pointer-events: all;
        cursor: wait;
    }
    .uov-spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e0e0e0;
        border-top-color: #333;
        border-radius: 50%;
        animation: uov-spin 0.8s linear infinite;
    }
    .uov-text {
        font-family: sans-serif;
        font-size: 14px;
        color: #333;
    }
    @@keyframes uov-spin {
        to { transform: rotate(360deg); }
    }
</style>

<div class="uov-container">
    <div id="@Id" class="@CssClass"></div>
    @if (IsLoading)
    {
        <div class="uov-overlay">
            <div class="uov-spinner"></div>
            <span class="uov-text" dir="auto">@LoadingText</span>
        </div>
    }
</div>